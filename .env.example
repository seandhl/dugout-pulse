# Separate service settings for demo / staging / production; all remain DATA_MODE=DEMO.
APP_ENV=
PUBLICATION_STATE=

# Empty means DEMO. Only DEMO is supported. No credentials required.
DATA_MODE=

# DB tools read exported environment variables (no automatic .env loading).
DATABASE_URL=
# Development Compose only. Never use development credentials in production.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Server-side SHA-256 of an explicitly provisioned 32–256 character admin token.
# Empty: deny all ingest uploads. Never use NEXT_PUBLIC_ or commit a real token.
INGEST_ADMIN_TOKEN_SHA256=

# Public deployment origin for canonical metadata; empty uses local preview origin.
SITE_URL=

# Private administrator origin only; production requires HTTPS and network ACL/VPN.
ADMIN_ORIGIN=
# Provision a unique operator identifier and >=64 character random signing secret.
ADMIN_ACTOR_ID=
ADMIN_SESSION_SECRET=

# Omit for default; performance selects the deterministic 600-player DEMO fixture.
DEMO_PROFILE=
