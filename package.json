{
  "name": "dugout-pulse",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26.11.0 <27"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:app": "next typegen && tsc --noEmit --project tsconfig.app.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ingest:e2e": "node scripts/ingest-e2e.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:smoke": "node scripts/db-smoke.mjs",
    "db:reset": "node scripts/demo-db.mjs reset",
    "db:seed": "node scripts/demo-db.mjs seed",
    "fixture:check": "vitest run tests/unit/fixture.test.ts",
    "demo:verify": "node scripts/demo-reproduce.mjs",
    "performance:bench": "PERFORMANCE=1 vitest run tests/unit/performance.test.ts",
    "performance:concurrency": "node scripts/performance-concurrency.mjs",
    "performance:browser": "node scripts/performance-browser.mjs",
    "momentum:validate": "node scripts/momentum-validation.mjs",
    "verify": "node scripts/verify.mjs",
    "test:core": "node scripts/test-core.mjs",
    "test:migrations": "node scripts/validate-migrations.mjs",
    "deploy:smoke": "node scripts/deploy-smoke.mjs",
    "db:deploy:sql": "node scripts/migration-deploy.mjs"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "radix-ui": "1.8.1",
    "zod": "4.6.7",
    "sonner": "2.0.7"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tailwindcss": "4.3.4",
    "@tailwindcss/postcss": "4.3.4",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.6.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "vitest": "5.1.0",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.11.0"
  }
}
